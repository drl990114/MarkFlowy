{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "outDir": "./dist-types/",
    "preserveSymlinks": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "noEmit": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@markflowy/i18n/desktop": [
        "../../packages/i18n/src/desktop.ts"
      ],
      "@markflowy/interface": [
        "../../packages/interface/src/index.ts"
      ],
      "@markflowy/theme/semantic": [
        "../../packages/theme/src/semantic/index.ts"
      ],
      "zens": [
        "../../packages/zens/src/index.ts"
      ],
      "zens/esm/components/*": [
        "../../packages/zens/src/components/*"
      ],
      "zens/esm/Theme/*": [
        "../../packages/zens/src/Theme/*"
      ]
    },
    "skipLibCheck": true
  },
  "include": [
    "src",
    "src/**/*.json",
    "src/types/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "dist-types",
    ".next",
    "coverage",
    "out",
    "tinykeys",
    ".cache",
    "**/node_modules",
    "**/dist",
    "**/dist-types",
    "**/.next",
    "**/coverage",
    "**/out",
    "**/.cache"
  ],
  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ]
}
