{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "outDir": "./dist-types/",
    "preserveSymlinks": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"],
      "@markflowy/i18n/desktop": ["../../packages/i18n/src/desktop.ts"],
      "@markflowy/theme/semantic": ["../../packages/theme/src/semantic/index.ts"]
    },
    "skipLibCheck": true
  },
  "include": ["src", "src/**/*.json", "src/types/*.d.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "dist-types",
    ".next",
    "coverage",
    "out",
    "tinykeys",
    ".cache",
    "**/node_modules",
    "**/dist",
    "**/dist-types",
    "**/.next",
    "**/coverage",
    "**/out",
    "**/.cache"
  ],
  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ]
}
