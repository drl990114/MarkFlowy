    {
      "id": "editor_copy",
      "configurable": false,
      "target": "native"
    },
    {
      "id": "editor_cut",
      "configurable": true,
      "target": "editor",
      "editor": {
        "rme": "cut"
      }
    },
    {
      "id": "editor_redo",
      "configurable": true,
      "target": "editor",
      "editor": {
        "rme": "redo",
        "capricornRule": "editor.history.redo.default"
      }
    },
    {
      "id": "editor_undo",
      "configurable": true,
      "target": "editor",
      "editor": {
        "rme": "undo",
        "capricornRule": "editor.history.undo.default"
