  "rules": [
    {
      "id": "editor_insertCodeBlock.default",
      "command": "editor_insertCodeBlock",
      "keys": ["CommandOrCtrl", "Alt", "[KeyC]"],
      "when": "editor_focus"
    },
    {
      "id": "editor_insertMathBlock.default",
      "command": "editor_insertMathBlock",
      "keys": ["CommandOrCtrl", "Alt", "[KeyM]"],
      "when": "editor_focus"
    },
    {
      "id": "app_zoomIn.default",
      "command": "app_zoomIn",
      "keys": ["CommandOrCtrl", "[Equal]"],
      "when": "always"
    },
    {
      "id": "app_zoomOut.default",
      "command": "app_zoomOut",
      "keys": ["CommandOrCtrl", "[Minus]"],
      "when": "always"
    },
    {
      "id": "app_zoomReset.default",
      "command": "app_zoomReset",
      "keys": ["CommandOrCtrl", "[Digit0]"],
      "when": "always"
    },
    {
      "id": "app_outlineCollapseAll.default",
      "command": "app_outlineCollapseAll",
      "keys": ["CommandOrCtrl", "Alt", "[BracketLeft]"],
      "when": "always"
    },
    {
      "id": "app_outlineExpandAll.default",
      "command": "app_outlineExpandAll",
      "keys": ["CommandOrCtrl", "Alt", "[BracketRight]"],
      "when": "always"
    },
    {
      "id": "app_commandPalette.default",
      "command": "app_commandPalette",
