      "configurable": false,
      "target": "native"
    },
    {
      "id": "editor_toggleStrong",
      "configurable": true,
      "target": "editor",
      "editor": {
        "rme": "toggleStrong",
        "capricornRule": "editor.format.bold.default"
      }
    },
    {
      "id": "editor_toggleEmphasis",
      "configurable": true,
