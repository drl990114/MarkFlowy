{
  "extends": "../../tsconfig.rollup.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "rootDir": "./src",
    "outDir": "./dist",
    "skipLibCheck": true,
    "types": [
      "react",
      "react-dom"
    ]
  },
  "include": [
    "./src"
  ],
  "exclude": [
    "./src/**/*.spec.ts",
    "./src/**/*.test.ts",
    "node_modules",
    "./src/**/*.js"
  ]
}
