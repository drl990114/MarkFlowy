{
  "name": "markflowy-monorepo",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "docs"
  ],
  "scripts": {
    "postinstall": "patch-package",
    "setup": "turbo postinstall",
    "yarn:id": "yarn install && yarn dedupe",
    "dev": "turbo dev",
    "dev:desktop": "node scripts/dev-desktop.mjs",
    "test:dev-desktop": "node --test scripts/dev-desktop.test.mjs",
    "test:security-dependencies": "node --test scripts/security-dependencies.test.mjs",
    "install:capricorn-runtime": "node --env-file-if-exists=.env scripts/install-capricorn-runtime.mjs",
    "build": "turbo build --concurrency=2",
    "build:web": "yarn turbo build --filter=!@markflowy/desktop",
    "build:desktop": "yarn turbo build --filter=!@markflowy/web && yarn workspace @markflowy/desktop tauri:build",
    "use-offline-bundle": "node scripts/use-offline-bundle.js",
    "delete": "turbo delete",
    "release": "node scripts/release.js",
    "release:patch": "yarn release --patch",
    "release:minor": "yarn release --minor",
    "release:major": "yarn release --major",
    "test": "turbo test",
    "updater": "yarn workspace @markflowy/desktop updater",
    "lint": "eslint --fix --ext .tsx ./",
    "translate:locals": "node --env-file=.env scripts/translate-locals.js",
    "translate:check": "node scripts/translate-check.js"
  },
  "devDependencies": {
    "@alicloud/alimt20181012": "^1.3.0",
    "@alicloud/openapi-client": "^0.4.13",
    "@alicloud/tea-util": "^1.4.10",
    "@babel/core": "^7.26.0",
    "@babel/eslint-parser": "^7.25.9",
    "@babel/eslint-plugin": "^7.25.9",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-decorators": "^7.25.9",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-react": "^7.25.9",
    "@babel/preset-typescript": "^7.26.0",
    "@codemirror/legacy-modes": "^6.5.2",
    "@halodong/eslint-config-react": "^0.38.24",
    "@rollup/plugin-node-resolve": "15.3.0",
    "@rollup/plugin-typescript": "11.1.6",
    "@rollup/plugin-url": "^8.0.2",
    "babel": "^6.23.0",
    "child_process": "^1.0.2",
    "eslint": "9.39.5",
    "fast-glob": "^3.3.2",
    "patch-package": "^8.0.1",
    "postcss": "^8.5.28",
    "postcss-import": "^16.1.1",
    "postcss-nested": "^7.0.2",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "rollup": "4.63.4",
    "rollup-plugin-postcss": "^4.0.2",
    "typescript": "^5.7.3"
  },
  "packageManager": "yarn@4.8.0",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "dependencies": {
    "turbo": "^2.9.14"
  },
  "resolutions": {
    "@babel/runtime@npm:7.23.6": "7.29.7",
    "@tauri-release/cli/@actions/github": "6.0.1",
    "@umijs/plugin-run/tsx": "4.23.15",
    "@utoo/pack/send": "0.19.2",
    "@xmldom/xmldom@npm:0.9.10": "0.9.12",
    "cross-spawn@npm:7.0.3": "7.0.6",
    "external-editor/tmp": "0.2.7",
    "html2sketch/uuid": "11.1.1",
    "less@npm:4.1.3": "4.9.1",
    "lodash@npm:4.17.21": "4.18.1",
    "mdx-bundler/uuid": "11.1.1",
    "nanoid@npm:3.3.12": "3.3.19",
    "path-to-regexp@npm:1.7.0": "1.9.0",
    "postcss@npm:8.4.49": "8.5.28",
    "qs@npm:~6.15.1": "6.16.0",
    "react-router-dom@npm:6.3.0": "6.30.6",
    "react-router@npm:6.3.0": "6.30.6",
    "remark-mdx-frontmatter/toml": "4.3.0",
    "undici@npm:^5.25.4": "6.28.1",
    "undici@npm:^5.28.5": "6.28.1",
    "undici@npm:^5.29.0": "6.28.1",
    "yaml@npm:~2.5.0": "2.9.0"
  }
}
